# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text eol=lf
*.pyc binary

# JavaScript
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# CSS
*.css text eol=lf
*.scss text eol=lf

# HTML
*.html text eol=lf

# Markdown
*.md text eol=lf

# Batch files
*.bat text eol=crlf

# Shell scripts
*.sh text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.xlsx binary
*.xls binary
*.csv binary
